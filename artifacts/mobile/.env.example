# Copy to ".env" in this folder (same directory as app.json). Expo loads EXPO_PUBLIC_* automatically.
# Never commit .env — it is gitignored.

# Required for real Lightning on device (same key you use in EAS / Breez)
EXPO_PUBLIC_BREEZ_API_KEY=

# Base URL of your API server (no trailing slash). Needed for web preview and features that call the server.
# On a real phone, use your computer's LAN IP if the API runs locally, e.g. http://192.168.1.10:3000
EXPO_PUBLIC_DOMAIN=

# Do not put owner/admin secrets in EXPO_PUBLIC_* variables.
# If you use WALLET_OWNER_TOKEN, keep it on the server only.
