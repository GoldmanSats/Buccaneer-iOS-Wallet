# Required: Neon Postgres connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Required: Port the server listens on (Railway sets this automatically)
PORT=8080

# Required: Public URL of this server (used to construct NWC relay URIs)
# Example: https://bellamy-api.up.railway.app
BELLAMY_DOMAIN=https://your-bellamy-domain.example.com

# Optional: Set to "0" to disable per-user agent access (defaults to enabled)
ENABLE_PER_USER_AGENT_ACCESS=1

# ---------------------------------------------------------------------------
# APNs (silent push) — required for autonomous agent execution while the app
# is backgrounded. See docs/BELLAMY_APNS_SETUP.md
# ---------------------------------------------------------------------------
# APNS_KEY_ID=
# APNS_TEAM_ID=
# Path to the .p8 file on this machine (use either APNS_KEY_PATH or APNS_KEY_BASE64)
# APNS_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
# Or: base64-encoded contents of the .p8 (useful on Railway / Docker secrets)
# APNS_KEY_BASE64=
# Must match ios.bundleIdentifier in the mobile app (Expo app.json)
# APNS_BUNDLE_ID=buccaneerwallet
# production = TestFlight / App Store; development = debug / dev client builds
# APNS_ENVIRONMENT=production
